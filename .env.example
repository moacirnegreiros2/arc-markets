# Arc Testnet RPC
ARC_RPC_URL=https://rpc.testnet.arc.network

# Deployer private key (generate with: cast wallet new)
# NEVER commit this file without the .example suffix
PRIVATE_KEY=0x...

# Optional: Etherscan-compatible API key (if Arc Testnet supports verification)
ETHERSCAN_API_KEY=

# Next.js public env vars (safe to expose)
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
